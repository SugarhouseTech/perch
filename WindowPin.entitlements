<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Intentionally empty. WindowPin is not sandboxed and loads no outside code,
  so it needs no entitlements under the hardened runtime. Accessibility and
  Screen Recording are permissions the user grants, not entitlements.
-->
<plist version="1.0">
<dict/>
</plist>
